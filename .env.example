# Best Style - variables de entorno
# Copia este archivo a .env.local (producción) o a .env.test.local (testing)
# y reemplaza los valores ficticios. Nunca subas archivos .env* con secretos.
#
# En Vercel:
#   - Production: valores del proyecto Supabase de producción.
#   - Preview (scoped a la rama testing): valores del proyecto Supabase de testing.
#   - Development (opcional): valores de testing para desarrollo local.
#
# AUTH_SECRET debe ser distinto en producción y en testing para que las
# sesiones (cookies firmadas) no se puedan reutilizar entre entornos.

# Conexión PostgreSQL (Supabase -> Connect -> Session pooler, puerto 6543).
# La contraseña debe ir URL-encoded si contiene caracteres especiales.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -hex 32
AUTH_SECRET=replace-with-a-strong-random-secret

# Proyecto Supabase (solo lo usa infrastructure/db/supabase-client.ts).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Referencia y región del proyecto (uso informativo / verificación).
SUPABASE_PROJECT_REF=PROJECT_REF
SUPABASE_DB_REGION=REGION
