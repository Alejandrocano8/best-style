{
  "name": "best-style",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:testing": "node --env-file=.env.test.local node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/apply-migration.mjs --target production",
    "db:migrate:testing": "node --env-file=.env.test.local scripts/apply-migration.mjs --target testing",
    "db:status:testing": "node --env-file=.env.test.local scripts/apply-migration.mjs --target testing --status",
    "db:seed:testing": "node --env-file=.env.test.local scripts/apply-migration.mjs --target testing --seed supabase/seed.testing.sql",
    "db:migrate:production": "node --env-file=.env.local scripts/apply-migration.mjs --target production --allow-production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "next": "latest",
    "pg": "^8.13.1",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.11.10",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
