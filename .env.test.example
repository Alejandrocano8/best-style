# Best Style - variables de entorno para TESTING
# Copia este archivo a .env.test.local y rellena con los datos del
# proyecto Supabase de testing. .env.test.local está en .gitignore.
#
# Usa SIEMPRE el proyecto de testing, nunca el de producción.
# El AUTH_SECRET debe ser distinto al de producción.

DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:TEST_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
AUTH_SECRET=replace-with-a-different-random-secret

NEXT_PUBLIC_SUPABASE_URL=https://TEST_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-test-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-test-publishable-key

SUPABASE_PROJECT_REF=TEST_PROJECT_REF
SUPABASE_DB_REGION=REGION
